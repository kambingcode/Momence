# Copy to worker/.env and fill it in. Don't commit .env. A non-empty shell variable wins over this file.

# Gemini API for clip discovery, B-roll plans, captions and hashtags: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional (defaults on the right). You can also change the Gemini model on the Settings page.
# CLIPSTUDIO_GEMINI_MODEL=gemini-3.6-flash
# CLIPSTUDIO_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# CLIPSTUDIO_DATA_DIR=        # must match web; default: ../data
# CLIPSTUDIO_WEB_DIR=         # the web/ folder (Remotion render script)
# CLIPSTUDIO_NODE=node        # Node command used for rendering
